# US Vesta – Apache / LiteSpeed (Hostinger) configuration
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS (Hostinger provides free SSL)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Block private folders and files
    RewriteRule ^(app|templates|database|storage|\.git)(/|$) - [F,L]
    RewriteRule ^(config\.local\.php|config\.sample\.php|README.*|.*\.sql|.*\.md|\.gitignore|\.env)$ - [F,L]

    # Serve real files under /static and /media directly, everything else goes to index.php
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^(static|media)/ - [L]
    RewriteRule ^(robots\.txt|favicon\.ico)$ - [L]

    RewriteRule ^ index.php [L,QSA]
</IfModule>

<FilesMatch "\.(sql|md|log|ser|bak|sqlite3?)$">
    Require all denied
</FilesMatch>

# Long-lived caching for static assets (Django used WHITENOISE_MAX_AGE = 1 year)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml text/plain image/svg+xml
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
